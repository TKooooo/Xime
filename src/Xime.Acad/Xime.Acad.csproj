<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;net48;net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Xime</AssemblyName>
    <RootNamespace>Xime.Plugin</RootNamespace>
    <Version>1.0.5</Version>
    <!--
      ★ AssemblyVersion **刻意恒为 1.0.0.0**，不要跟着版本号改：
        它是 CLR 的"程序集身份"，决定程序集能否被复用。插件跑在 acad.exe 内、
        程序集无法卸载 —— 改了它，同一次 AutoCAD 会话里 NETLOAD 另一份目录
        会变成"两套 Xime 并存"，补丁打不上、行为与日志对不上。
        对外显示版本 = <FileVersion>（XimeApplication.Version 读的就是它）。
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <Company>影子</Company>
    <Author>影子</Author>
    <Product>X输入法</Product>
    <Copyright>Copyright © 影子 2026</Copyright>
    <Description>X输入法 - AutoCAD 平台输入法智能切换插件（无视输入法模式）</Description>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../build/acad/</BaseOutputPath>
    <NoWarn>$(NoWarn);CS1591;CS0618;MSB3277;MSB3270</NoWarn>
    <RunAnalyzers>false</RunAnalyzers>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      ★ Release **不产 PDB**，这条是"交付一致性"的一部分：
        DebugType 会写进 PE 的调试目录，改了它，dist 里的 Xime.dll 就不再是
        已经验证过的那一份（md5 会变）。所以这里按配置区分，Release 保持 none。
      Debug 配置改产 portable PDB，供 VS Code / Visual Studio 附加到 acad.exe 打断点。
    -->
    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Prefer32Bit>false</Prefer32Bit>
    <!--
      ★ 声明"本项目需要 ObjectARX SDK"。
        仓库根的 Directory.Build.props 靠这个开关决定要不要做 SDK 存在性校验 ——
        只有这里需要，Xime.Core / Xime.CliTest 都不需要。
    -->
    <XimeNeedsAcadSdk>true</XimeNeedsAcadSdk>
    <!--
      ★★ 宿主编译符号（本次扩展）：插件层是**共享源码**，靠这个符号切换宿主 API 命名空间。
         HOST_AUTOCAD / HOST_ZWCAD / HOST_GSTARCAD 三选一，各工程各自定义其一。
         用 $(DefineConstants) 前缀是必须的 —— 直接赋值会把 SDK 默认的
         TRACE / DEBUG 等符号一起抹掉。
    -->
    <DefineConstants>$(DefineConstants);HOST_AUTOCAD</DefineConstants>
    <!-- DLL 自身携带 X输入法 图标（资源管理器 / 属性对话框可见） -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\Xime.Core\Resources\XimeLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    ★★ 共享插件层源码（本次扩展）：XimeApplication / XimeCommands / Compat 三个文件
       由 AutoCAD / 中望 / 浩辰 三个工程**同时编译**，靠 DefineConstants 区分宿主。
       改一处 = 三家同时生效，不存在"三份代码各自漂移"的问题。
       链接进来时保持目录结构（Link 前缀 Plugin\），在 IDE 里一眼能看出哪些是共享的。
  -->
  <ItemGroup>
    <Compile Include="..\Xime.Plugin\**\*.cs" LinkBase="Plugin" />
  </ItemGroup>

  <!-- AutoCAD 托管程序集引用目录
       ★ SdkRoot 的**来源已经不在这里**，见仓库根的 Directory.Build.props：
         支持 -p:SdkRoot= / local.props / 环境变量 ACAD_SDK_ROOT / 仓库同级目录 四种方式，
         以免把某个人的绝对路径写死进公开仓库。
         net35  -> AutoCAD 2010-2012（ObjectARX SDK 2010-R18.0，.NET 3.5）
         net48  -> AutoCAD 2013-2024（ObjectARX SDK 2014-R19.1，.NET 4.x）
         net8   -> AutoCAD 2025-2026（API 与 2014 兼容，编译期复用 2014 程序集）
       可用 -p:Acad35RefDir=... / -p:Acad48RefDir=... 直接覆盖到具体目录。 -->

  <!-- net35：AutoCAD 2010-2012 SDK。该版本尚无 AcCoreMgd，类型都在 AcMgd 内 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <Reference Include="acdbmgd">
      <HintPath>$(Acad35RefDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(Acad35RefDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- net48：引用 ObjectARX 2014(R19.1) 托管程序集，兼容 2013-2024 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="accoremgd">
      <HintPath>$(Acad48RefDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(Acad48RefDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(Acad48RefDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- net8：AutoCAD 2025+ 使用 .NET 8 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Reference Include="accoremgd">
      <HintPath>$(Acad8RefDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(Acad8RefDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(Acad8RefDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xime.Core\Xime.Core.csproj" />
  </ItemGroup>

</Project>
