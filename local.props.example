<Project>

  <!--
    ============================================================
     本机专属配置模板 —— 复制成 local.props 后按自己的路径改
     ============================================================

     用法：
       1. 把本文件复制一份，改名为 local.props（**同一目录，即仓库根**）
       2. 把下面的路径改成你机器上 ObjectARX SDK 的实际位置
       3. local.props 已被 .gitignore 忽略，不会进版本库，
          所以每个人的路径互不干扰

     ★ 为什么要有这个文件：
       ObjectARX SDK 由 Autodesk 提供（随 ObjectARX 下载包分发），
       版权不允许随本仓库一起提交，所以只能由使用者自行准备，
       再用这个文件把"它放在哪"告诉编译器。

     需要的两个子目录（ObjectARX 官方下载包里都有）：
       2010-R18.0\inc-x64   -> AutoCAD 2010 / 2011 / 2012 的引用程序集
       2014-R19.1\inc       -> AutoCAD 2013 ~ 2024 的引用程序集
                               （net8.0-windows 目标复用这一份）

     想要的具体引用文件：
       AcMgd.dll / AcDbMgd.dll / AcCoreMgd.dll（2014 及以后才有 AcCoreMgd）
    ============================================================
  -->

  <PropertyGroup>
    <!-- 改成你自己的路径。反斜杠不用转义，写成单行即可。 -->
    <SdkRoot>D:\ObjectARX-SDK</SdkRoot>
  </PropertyGroup>

  <!--
    ============================================================
     中望 CAD / 浩辰 CAD 的宿主程序集（v1.1.0 新增）

     ★ 与 ObjectARX SDK 不同：这两家的宿主 API 程序集**随软件一起安装**，
       不需要额外下载。**通常不用在这里配** —— Directory.Build.props 会按
       注册表里"当前版本分支"的 Location / LOCATION 自动定位到安装目录。

       只有在下面两种情况才需要手动指定：
         · 自动定位失败（比如装的是绿色版、注册表被清过）；
         · 想拿另一台机器的安装目录来编译。

     需要指向**安装目录本身**（不是某个 SDK 子目录）：
       中望：<安装目录>  里要有 ZwManaged.dll、ZwDatabaseMgd.dll
       浩辰：<安装目录>  里要有 GcCoreMgd.dll、GcDbMgd.dll、GcMgd.dll
    ============================================================
  -->
  <PropertyGroup>
    <!-- 示例（按需取消注释并改成自己的路径）：
    <ZwcadRefDir>C:\Program Files\ZWSOFT\ZWCAD 2026</ZwcadRefDir>
    <GstarCadRefDir>C:\Program Files\浩辰软件\浩辰CAD2026</GstarCadRefDir>
    -->
  </PropertyGroup>

</Project>
